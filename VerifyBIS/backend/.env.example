DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/verifybis

FRONTEND_URL=http://localhost:5173

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

JWT_SECRET_KEY=your-long-random-secret-key

SESSION_COOKIE_SECURE=false

GROQ_API_KEY=your-groq-api-key

BIS_MANIFEST_PATH=C:/VerifyBIS-data/BIS_Manifest.csv

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# OCR (scanned PDFs and image uploads). Defaults shown; all are optional.
# Pages that already have a text layer never touch OCR, so these only affect
# scans. Needs the tesseract binary — already installed in the Docker image.
#OCR_ENABLED=true
#OCR_LANGUAGE=eng
#OCR_DPI=300
#OCR_MAX_WORKERS=4
#OCR_MAX_PAGES=50
# Only needed when tesseract is not on PATH, e.g. running natively on Windows:
#OCR_TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe